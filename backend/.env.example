# ==============================================================================
# MeetLoop Agent Configuration (.env.example)
# ==============================================================================

# OpenRouter LLM Gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Swytchcode API Engine & Tooling
SWYTCHCODE_API_KEY=your_swytchcode_api_key_here

# Notion Destination Integration
NOTION_WORKSPACE_ID=your_notion_workspace_id
NOTION_HEALTH_REPORT_PARENT_PAGE_ID=your_notion_parent_page_id

# Gmail Manager Digest Integration
GMAIL_TEST_ACCOUNT=manager@example.com

# Slack Weekly Pulse Integration
SLACK_WORKSPACE_ID=your_slack_workspace_id
SLACK_CHANNEL_ID=C0C4DT5SW5R

# Google Meet REST API (Optional transcript ingestion)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Server Config
FASTAPI_PORT=8000
